# NFE PropertyScope — standalone application
NEXT_PUBLIC_APP_NAME="NFE PropertyScope"
NEXT_PUBLIC_APP_ENV="local"

# Client-safe adapter selection only. Never place a credential in NEXT_PUBLIC_*.
NEXT_PUBLIC_NFE_OS_ADAPTER_MODE="mock"

# Approved NFE-OS Protected Research Service Contract v0.1.
# PRIVATE LIVE RESEARCH is server-to-server and preview-only in this bounded release.
# NFE_RESEARCH_SERVICE_URL must be the approved PLATFORM HTTPS /api/research endpoint.
NFE_RESEARCH_SERVICE_URL=""
NFE_RESEARCH_SERVICE_TOKEN=""
PROPERTYSCOPE_PRIVATE_LIVE_RESEARCH="false"

# Future Builder #2 Supabase connection
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Future visual provider
VISUAL_GENERATION_API_KEY=""
